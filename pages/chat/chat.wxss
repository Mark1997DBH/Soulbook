.chat-page { padding: 20rpx; box-sizing: border-box; height: 100vh; display: flex; flex-direction: column; gap: 20rpx; }
.config-card .title { margin-bottom: 16rpx; }
.api-input { border: 1rpx solid #e8e8e8; border-radius: 16rpx; padding: 16rpx; font-size: 28rpx; }
.config-actions { margin-top: 16rpx; display: flex; gap: 16rpx; }
.mini-btn { background: #fff3cd; color: #7a5b00; }
.role-card { color: #666; font-size: 26rpx; }
.messages { flex: 1; overflow: hidden; }
.msg-row { margin: 14rpx 0; display: flex; }
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }
.msg-bubble { max-width: 82%; padding: 16rpx 20rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.5; }
.msg-row.user .msg-bubble { background: #ffe7a6; color: #333; }
.msg-row.assistant .msg-bubble { background: #f2f4f7; color: #333; }
.input-bar { margin-bottom: 0; }
.input-box { width: 100%; min-height: 120rpx; max-height: 220rpx; border: 1rpx solid #ececec; border-radius: 16rpx; padding: 16rpx; box-sizing: border-box; margin-bottom: 16rpx; }
.send-btn { width: 100%; }
