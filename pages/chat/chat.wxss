.config-card,.composer{ width:100%; margin-bottom:20rpx; }
.api-input{ background:#fff7f9; border-radius:16rpx; padding:18rpx 22rpx; font-size:26rpx; }
.actions-row{ display:flex; gap:16rpx; margin-top:16rpx; }
.btn-ghost{ background:#fff; color:#ff7f9f; border:1rpx solid #ffc2d1; }
.chat-list{ width:100%; height:760rpx; padding:24rpx; box-sizing:border-box; }
.chat-item{ display:flex; margin-bottom:20rpx; }
.chat-item.user{ justify-content:flex-end; }
.chat-item.assistant{ justify-content:flex-start; }
.bubble{ max-width:78%; padding:16rpx 20rpx; border-radius:18rpx; line-height:1.6; font-size:28rpx; }
.user .bubble{ background:#ffd9e4; color:#6d214f; }
.assistant .bubble{ background:#fff4c2; color:#5c4400; }
.typing{ opacity:.8; font-style:italic; }
.composer .input{ width:100%; min-height:130rpx; background:#fff; border-radius:16rpx; padding:16rpx; margin-bottom:16rpx; box-sizing:border-box; }
