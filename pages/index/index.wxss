.header {
  width: 100%;
  padding: 20rpx 10rpx;
  margin-bottom: 20rpx;
}

.date-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
  display: block;
}

.list-container {
  width: 100%;
  padding-bottom: 50rpx;
}

.record-item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx;
}

.record-left {
  margin-right: 30rpx;
}

.mood-circle {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.emoji {
  font-size: 40rpx;
}

.record-content {
  flex: 1;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.record-date {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-note {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.entry-wrap { width: 100%; margin-bottom: 18rpx; }
.ai-btn { width: 100%; }
